<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK projections give us Windows.UI.Composition for the full-screen light. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.18362.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <!-- Off on purpose: WPF + WinForms implicit usings collide (Application, MessageBox, Point...). -->
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FlickDesk</AssemblyName>
    <RootNamespace>FlickDesk</RootNamespace>
    <StartupObject>FlickDesk.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.3.3</Version>
    <!-- Lets the project also build from macOS/Linux CI. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Single-file publish: WPF's native DLLs (wpfgfx, PresentationNative, D3DCompiler...) must be
         packed into the exe too, or a lone FlickDesk.exe exits silently at start-up. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- QR code generation for pairing (MIT licence). -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

</Project>
